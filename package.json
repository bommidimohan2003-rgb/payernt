{
  "name": "payent_monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "build": "npm run build --workspace=frontend && node -e \"if (fs.existsSync('frontend/.vercel/output')) fs.cpSync('frontend/.vercel/output', '.vercel/output', {recursive: true})\"",
    "preview": "npm run preview --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "format": "npm run format --workspace=frontend",
    "dev:backend": "cd backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8001",
    "dev:all": "start npm run dev:backend && npm run dev",
    "test:backend": "cd backend && pytest"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "@rolldown/binding-linux-x64-musl": "1.1.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.2",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.2",
    "lightningcss": "1.32.0",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-linux-x64-musl": "^1.32.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
