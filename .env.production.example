# ==========================================================
# PAYENT PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================================
# Target Architecture: Cloudflare Workers (Frontend) -> Railway (FastAPI) -> TiDB Cloud (MySQL)
# IMPORTANT: Never commit actual secret keys to source control.
# Set these values in your Railway & Cloudflare project dashboards.

# --- 1. ENVIRONMENT MODE (Railway) ---
ENV=production
ENVIRONMENT=production
IS_PRODUCTION=true

# --- 2. FASTAPI BACKEND SECRETS (Railway) ---
# Generate 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_HIGH_ENTROPY_PRODUCTION_JWT_KEY

# Strict Admin Setup Code required for bootstrap admin registration
ADMIN_SETUP_CODE=REPLACE_WITH_STRONG_ADMIN_SETUP_CODE
ADMIN_CREATION_SECRET=REPLACE_WITH_STRONG_ADMIN_CREATION_SECRET

# --- 3. DATABASE CONFIGURATION (TiDB Cloud MySQL) ---
# Obtain these credentials from your TiDB Cloud Cluster dashboard under Connect -> Standard Connection
MYSQL_HOST=your-cluster-host.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=your_tidb_username
MYSQL_PASSWORD=REPLACE_WITH_TIDB_CLOUD_PASSWORD
MYSQL_DB=payent_marketplace_db
MYSQL_SSL=true

# --- 4. CORS ORIGINS (Railway) ---
# Comma-separated list of allowed frontend domains
ALLOWED_ORIGINS=https://frontend.bommidimohan2003.workers.dev,https://payent.in,https://www.payent.in

# --- 5. RAZORPAY LIVE MODE PAYMENT GATEWAY & WEBHOOKS (Railway) ---
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# --- 6. FRONTEND VITE ENVIRONMENT (Cloudflare Dashboard / wrangler.jsonc) ---
VITE_API_URL=https://payernt-production.up.railway.app

