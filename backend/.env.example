# ==============================================================================
# PAYENT FASTAPI BACKEND - RAILWAY ENVIRONMENT CONFIGURATION TEMPLATE
# Copy and paste these into your Railway Service -> Variables -> RAW Editor
# ==============================================================================

# Core Environment
ENV=production
IS_PRODUCTION=true
ALLOWED_ORIGINS=https://frontend.bommidimohan2003.workers.dev,https://payent.in,https://www.payent.in

# TiDB Cloud Serverless Connection (TLS Enabled)
TIDB_HOST=your-tidb-cluster-host.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_DATABASE=payent_marketplace_db
TIDB_SSL=true
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password

# PyMySQL Fallback Aliases
MYSQL_HOST=your-tidb-cluster-host.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DB=payent_marketplace_db
MYSQL_SSL=true
MYSQL_USER=your_tidb_username
MYSQL_PASSWORD=your_tidb_password

# JWT Authentication Config (Generate 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your_production_high_entropy_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Admin Creation Code
ADMIN_SETUP_CODE=your_production_admin_setup_code_here
ADMIN_CREATION_SECRET=your_production_admin_creation_secret_here

