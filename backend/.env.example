# ==============================================================================
# PAYENT FASTAPI BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy and configure these variables for your environment (Railway / Docker / Local)
# ==============================================================================

# Core Environment
ENV=production
IS_PRODUCTION=true
ALLOW_PRODUCTION_TESTING=false
ALLOWED_ORIGINS=https://frontend.bommidimohan2003.workers.dev,https://payent.in,https://www.payent.in

# TiDB Cloud Serverless Connection (TLS 1.3 Enabled)
TIDB_HOST=your-tidb-cluster-host.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_DATABASE=payent_marketplace_db
TIDB_SSL=true
TIDB_USER=your_tidb_username
TIDB_PASSWORD=your_tidb_password

# PyMySQL Fallback Aliases
MYSQL_HOST=your-tidb-cluster-host.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_DB=payent_marketplace_db
MYSQL_SSL=true
MYSQL_USER=your_tidb_username
MYSQL_PASSWORD=your_tidb_password

# JWT Authentication Config (Generate 64-char hex key via: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=your_production_high_entropy_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Keyed HMAC PIN & Security Secrets (Must not be identical to JWT_SECRET_KEY)
PIN_HASH_SECRET=your_production_high_entropy_pin_hash_secret_32_bytes_min
ADMIN_SETUP_CODE=your_production_admin_setup_code_here
ADMIN_CREATION_SECRET=your_production_admin_creation_secret_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SMS & OTP Provider (Twilio Verify)
OTP_PROVIDER=twilio
ENABLE_TWILIO_SMS=true
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DISABLE_TWILIO_FOR_FIREBASE=true

# Cloudinary Asset Storage & CDN
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=payernt_uploads.
CLOUDINARY_URL=

# Transactional SMTP Mailer
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=payentsupport@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
MAIL_FROM=payentsupport@gmail.com
MAIL_FROM_NAME="paYent Security"

# Social Authentication & Frontend URL
FRONTEND_URL=https://frontend.bommidimohan2003.workers.dev
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
