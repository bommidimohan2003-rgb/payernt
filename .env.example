# ============================================================
# PAYENT ROOT CONFIGURATION TEMPLATE
# ============================================================

# Database Configuration (MySQL / TiDB)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DB=payent_marketplace_db
MYSQL_SSL=false

# Environment
ENV=development
ALLOW_PRODUCTION_TESTING=true

# Authentication Security
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
PIN_HASH_SECRET=dev_keyed_pin_hash_secret_safe_for_testing_only_32_bytes_min
ADMIN_SETUP_CODE=PAYENT-ADMIN-SECRET-2026
ADMIN_CREATION_SECRET=PAYENT-ADMIN-SECRET-2026

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS / OTP Provider (Twilio Verify)
OTP_PROVIDER=mock
ENABLE_TWILIO_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=dvyendk6j
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=payernt_uploads.

# SMTP Email Delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@payent.in
MAIL_FROM_NAME="Payent Security"

# URLs & Client IDs
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
