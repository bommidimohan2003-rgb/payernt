# ============================================================
# PAYENT CONFIGURATION TEMPLATE
# ============================================================

# Database Configuration (MySQL / TiDB)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DB=payent_marketplace_db
MYSQL_SSL=false

# Environment
ENV=development
ALLOW_PRODUCTION_TESTING=true

# Authentication Security
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
ADMIN_SETUP_CODE=PAYENT-ADMIN-SECRET-2026

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS / OTP Provider (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
